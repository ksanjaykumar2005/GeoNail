# Server Network Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# LoRa Gateway Configuration
GATEWAY_ID=GW-01
MONITORED_ZONE=Extraction Zone 01

# Email Alert Configuration (Nodemailer)
# If unconfigured, the system reports "EMAIL NOT CONFIGURED"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=geonail.alerts@gmail.com
SMTP_PASS=your_app_password_here
ALERT_EMAIL_TO=phoenix.team0091@gmail.com

# SMS Alert Configuration (Twilio)
# If unconfigured, the system reports "SMS NOT CONFIGURED"
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18005550199
ALERT_SMS_RECIPIENTS=+919876543210
