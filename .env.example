# ==============================================================================
# GeoNail - Mine Safety Monitoring System Configuration
# SIH 2026 Problem Statement: PS 26025
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Vite)
# ------------------------------------------------------------------------------
# In production on Vercel, set VITE_API_URL to your deployed Render backend URL.
# Example: VITE_API_URL=https://geonail-backend.onrender.com
VITE_API_URL=
# Optional explicit WebSocket URL (auto-derived as wss://... if left empty)
VITE_WS_URL=

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Render / Node.js)
# ------------------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# CORS allowed origins (Comma-separated or your Vercel frontend domain)
# Example: FRONTEND_URL=https://geonail.vercel.app
FRONTEND_URL=
ALLOWED_ORIGINS=https://geonail.vercel.app,http://localhost:5173

# Optional PostgreSQL / TimescaleDB Database URL (Falls back to in-memory store if unset)
# Example: DATABASE_URL=postgresql://postgres:password@localhost:5432/geonail
DATABASE_URL=

# LoRa Gateway Metadata
GATEWAY_ID=GW-01
MONITORED_ZONE=Extraction Zone

# ------------------------------------------------------------------------------
# 3. EMERGENCY EMAIL ALERT CONFIGURATION (Nodemailer / SMTP)
# ------------------------------------------------------------------------------
# If unconfigured in environment, backend reports truthful "EMAIL NOT CONFIGURED".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=phoenix.team0091@gmail.com

# ------------------------------------------------------------------------------
# 4. SMS ALERT CONFIGURATION (Twilio - Optional)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_SMS_RECIPIENTS=
